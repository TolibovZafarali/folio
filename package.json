{
  "name": "folio-reader",
  "version": "1.2.0",
  "description": "A compact offline PDF and EPUB reader with a persistent local bookshelf.",
  "author": "TolibovZafarali",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "build:ui": "node scripts/prepare-pdf.mjs && vite build",
    "start": "npm run build:ui && electron .",
    "build": "npm run build:ui && electron-builder --win nsis --x64 --publish never",
    "test": "node --test test/library.test.cjs test/updates.test.cjs test/release.test.cjs test/trusted-entry.test.cjs",
    "test:app": "npm run build:ui && node --test test/electron.test.mjs",
    "test:installed": "node --test test/installed.test.mjs"
  },
  "build": {
    "appId": "com.folio.reader",
    "productName": "Folio Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "library.cjs",
      "epub.mjs",
      "ui/**/*",
      "package.json",
      "updates.cjs",
      "trusted-entry.cjs"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "artifactName": "Folio-Reader-Setup-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TolibovZafarali",
        "repo": "folio",
        "releaseType": "release",
        "tagNamePrefix": "reader-v"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "js-yaml": "^5.5.0",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.65.0",
    "vite": "^8.3.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TolibovZafarali/folio.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fflate": "0.8.3"
  }
}
